# Copy this file to .env and fill in real values. Never commit secrets.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/todo-app
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Extra browser origins, comma-separated. Use this for Vercel preview URLs.
# ADDITIONAL_ORIGINS=https://your-preview.vercel.app

# Email: set EMAIL_PROVIDER to sendgrid or resend so leftover keys cannot win.
# Plan 2 (no domain): SendGrid Single Sender + your Gmail.
# 1. Create a free account at https://signup.sendgrid.com
# 2. Settings → Sender Authentication → Verify a Single Sender (your Gmail)
# 3. Settings → API Keys → Create API Key (Full Access or Mail Send)
# 4. Paste the key below and set EMAIL_FROM to that same Gmail.
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=TaskFlow <you@gmail.com>

# OTP
OTP_EXPIRY_MS=300000
# Local only. Never set this to true on a live host.
OTP_DEV_MODE=true

# Optional: protect POST /api/jobs/tick for an external cron
JOB_SECRET=
JOB_INTERVAL_MS=60000

# Optional Cloudinary avatar uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional web push (not required for in-app notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Hybrid assistant (server-side only). Leave AI_API_KEY empty to stay deterministic.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=

# Optional live search for current news/weather/prices. Leave none to refuse guesses.
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# Production host checklist (set these on Render / Railway / your VM, not in this file):
# NODE_ENV=production
# OTP_DEV_MODE=false
# MONGO_URI=mongodb+srv://...
# JWT_SECRET=<long random string>
# CLIENT_URL=https://to-do-project-react-one.vercel.app
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxx
# EMAIL_FROM=TaskFlow <you@gmail.com>
# Leave RESEND_API_KEY empty, or keep it but EMAIL_PROVIDER=sendgrid must be set.
# The Gmail in EMAIL_FROM must be the verified SendGrid Single Sender.
