# Copy this file to .env and fill in real values. Never commit secrets.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/todo-app
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Extra browser origins, comma-separated. Use this for Vercel preview URLs.
# ADDITIONAL_ORIGINS=https://your-preview.vercel.app

# Email: use ONE provider. Do not mix a SendGrid key with a Resend from-address.
# SendGrid: SENDGRID_API_KEY=SG.xxxxx and EMAIL_FROM=TaskFlow <you@yourdomain.com>
# Resend:   RESEND_API_KEY=re_xxxxx and EMAIL_FROM=TaskFlow <you@yourdomain.com>
SENDGRID_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=TaskFlow <you@yourdomain.com>

# OTP
OTP_EXPIRY_MS=300000
# Local only. Never set this to true on a live host.
OTP_DEV_MODE=true

# Optional: protect POST /api/jobs/tick for an external cron
JOB_SECRET=
JOB_INTERVAL_MS=60000

# Optional Cloudinary avatar uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional web push (not required for in-app notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Production host checklist (set these on Render / Railway / your VM, not in this file):
# NODE_ENV=production
# OTP_DEV_MODE=false
# MONGO_URI=mongodb+srv://...
# JWT_SECRET=<long random string>
# CLIENT_URL=https://to-do-project-react-one.vercel.app
# EMAIL_FROM=TaskFlow <onboarding@resend.dev>
# RESEND_API_KEY=re_....
# Leave SENDGRID_API_KEY empty if you are using Resend.
